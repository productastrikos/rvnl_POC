# Copy to .env.local for local overrides. All REACT_APP_* values are inlined
# into the public bundle at build time — never put secrets here.
#
# The application currently runs entirely client-side against the bundled
# dataset in src/data/rvnlData.js, so no backend URL is required. The two
# variables below are placeholders for when src/services/api.js is pointed at
# a real backend.

# REACT_APP_API_URL=https://api.example.com
# REACT_APP_SOCKET_URL=https://api.example.com

# Subpath the app is served from. Leave as / for a domain root.
# See client/.env.production for the value used by production builds.
PUBLIC_URL=/
