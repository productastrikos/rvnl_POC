# ═══════════════════════════════════════════════════════════════════════════
#  Production build settings — read by react-scripts during `npm run build`.
#  Committed on purpose: these are build flags, not secrets. Never put
#  credentials in a REACT_APP_* variable — everything here is inlined into the
#  JavaScript bundle and is readable by anyone who opens the site.
# ═══════════════════════════════════════════════════════════════════════════

# Do not ship source maps. They add ~3.3 MB to the upload and expose the full
# unminified source of the application.
GENERATE_SOURCEMAP=false

# Treat lint warnings as warnings, not build failures.
CI=false

# Where the app is served from.
#   Domain root  (https://example.com/)             -> /
#   Subfolder    (https://example.com/nirman-setu/)  -> /nirman-setu
# Changing this rewrites every asset URL and the React Router basename.
PUBLIC_URL=/
