{
  "name": "rvnl-nirman-setu",
  "version": "1.0.0",
  "description": "RVNL Nirman Setu — Integrated Project Command Centre for Rail Vikas Nigam Limited",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npm start --prefix client",
    "start": "npm start --prefix client",
    "build": "npm run build --prefix client",
    "test": "npm test --prefix client -- --watchAll=false",
    "install:all": "npm install --prefix client",
    "install:ci": "npm ci --prefix client",
    "package": "npm run build && node scripts/package.js",
    "preview": "npx --yes serve -s client/build -l 5000",
    "clean": "node -e \"require('fs').rmSync('client/build',{recursive:true,force:true});require('fs').rmSync('dist',{recursive:true,force:true})\""
  }
}
